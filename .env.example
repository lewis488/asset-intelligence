# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://user:password@localhost:5432/asset_intelligence
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ── Optional overrides ────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production
LLM_MODEL=claude-sonnet-4-5

# CORS (comma-separated)
ALLOWED_ORIGINS_RAW=http://localhost:5173,http://localhost:3000

# ── Scoring model weights ─────────────────────────────────────────────────────
# Increment SCORING_VERSION whenever you change weights so model evolution is tracked

SCORING_VERSION=1.0.0

# CI band thresholds (UKPMS — lower CI = worse)
CI_GREEN_THRESHOLD=40.0    # Green: CI < 40
CI_AMBER_THRESHOLD=100.0   # Amber: 40–99; Red: >=100
CI_GREEN_MAX=10.0
CI_AMBER_MAX=25.0
CI_RED_MAX=40.0

# Defect driver score — tune these as real data analysis refines the model
DD_LPV_THRESHOLD=0.40      # LPV dominant if >40% of CI contribution
DD_LPV_POINTS=15.0
DD_RUTTING_THRESHOLD=0.35
DD_RUTTING_POINTS=15.0
DD_TEXTURE_THRESHOLD=0.50
DD_TEXTURE_POINTS=8.0
DD_CRACKING_THRESHOLD=0.40
DD_CRACKING_POINTS=12.0
DD_HIGH_RED_THRESHOLD=0.15 # >15% section in Red → +10 pts
DD_HIGH_RED_POINTS=10.0
DD_HIGH_AMBER_THRESHOLD=0.40
DD_HIGH_AMBER_POINTS=5.0

# EDI score (B+C roads only)
EDI_LOW_THRESHOLD=20.0
EDI_MID_THRESHOLD=35.0
EDI_HIGH_THRESHOLD=50.0
EDI_LOW_POINTS=5.0
EDI_MID_POINTS=10.0
EDI_HIGH_POINTS=15.0

# Reactive maintenance score
REACTIVE_JOB_POINTS=3.0
REACTIVE_JOB_MAX=9.0
REACTIVE_EMERGENCY_POINTS=2.0
REACTIVE_EMERGENCY_MAX=6.0
REACTIVE_LOOKBACK_MONTHS=12
REACTIVE_EMERGENCY_LOOKBACK_MONTHS=6

# Risk band thresholds
RISK_CRITICAL=65.0
RISK_HIGH=40.0
RISK_MEDIUM=20.0
