# Frontend environment variables for Vite. Copy to .env.local and fill in values.
# Vite exposes only vars prefixed with VITE_ to the client bundle.

# OS Maps API key for Vaisala Map tab basemap.
# Get a key from https://osdatahub.os.uk/ (create a project and add "OS Maps API").
# Leaving this unset falls back to OpenStreetMap tiles.
VITE_OS_MAPS_API_KEY=
